# Base de datos. En Railway: ${{Postgres.DATABASE_URL}}. Se acepta postgresql:// tal cual.
DATABASE_URL=postgresql://francisco:francisco@localhost:5432/francisco

# Claves de la API REST: nombre:clave separados por comas.
API_KEYS=francisco:cambie-esta-clave

# Telegram (opcional). Sin estas dos variables el bot queda apagado y la API funciona igual.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# URL pública del servicio, sin barra final. En Railway se puede omitir: se usa RAILWAY_PUBLIC_DOMAIN.
PUBLIC_URL=

# Anthropic (opcional). Sin la clave el bot contesta que el asistente no está configurado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Reglas del negocio.
MARKUP=0.25
TIMEZONE=America/Caracas
